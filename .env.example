# Recipient for the shareable Drive link notification
NOTIFY_EMAIL=recipient@example.com

# Google account used by Workspace MCP tools (user_google_email)
GOOGLE_USER_EMAIL=you@gmail.com

# Required for Drive/Gmail MCP — create an OAuth 2.0 Client ID in Google Cloud Console
# (APIs & Services → Credentials). Enable Drive API + Gmail API.
# Redirect URI: http://localhost:8001/oauth2callback
#
# Enable BOTH APIs for the same Cloud project as your OAuth client:
#   - Google Drive API
#   - Gmail API  → https://console.developers.google.com/apis/api/gmail.googleapis.com/overview
#
# If Google shows "Error 403: access_denied" / "has not completed the Google verification
# process": OAuth consent screen is in Testing mode. Add your GOOGLE_USER_EMAIL under
# OAuth consent screen → Audience/Test users (or publish the app — not needed for personal use).
#
# CLI OAuth: you do NOT need a web app. Workspace MCP starts a temporary server on
# localhost:8001 to receive Google's redirect. Keep the Python process running until
# the browser finishes; tokens are saved under ~/.google_workspace_mcp/credentials/.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional alternative to the two vars above:
# GOOGLE_CLIENT_SECRET_PATH=/absolute/path/to/client_secret.json

# How long the CLI waits (seconds) for browser OAuth while keeping MCP alive
GOOGLE_OAUTH_WAIT_SECONDS=300

# Optional: Ollama model (default matches existing summarize call)
OLLAMA_MODEL=llama3.2:3b

# Optional: override MCP server launch commands (shlex-split)
# Requires: uv on PATH (https://docs.astral.sh/uv/) so `uvx workspace-mcp` works,
# plus one-time Google OAuth for Workspace MCP (see workspacemcp.com/docs).
# Defaults (used when unset):
#   DRIVE_MCP_COMMAND=uvx workspace-mcp --tools drive --tool-tier core
#   EMAIL_MCP_COMMAND=uvx workspace-mcp --tools gmail --tool-tier core
#   AUTH_MCP_COMMAND=uvx workspace-mcp --tools drive gmail --tool-tier core
